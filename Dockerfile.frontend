# syntax=docker/dockerfile:1
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install uv (fast Python package manager)
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./
# Create virtualenv and install app dependencies from lockfile
RUN uv sync --frozen --no-dev \
    && uv run python -c "import sys; print(sys.version)" >/dev/null

COPY src/frontend ./src/frontend

EXPOSE 5000

# Env required: BACKEND_URL, BACKEND_API_KEY
CMD ["uv", "run", "hypercorn", "src.frontend.app:app", "--bind", "0.0.0.0:5000"]
