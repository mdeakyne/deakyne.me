## Frontend (Quart) -> Backend (FastAPI) wiring
# Base URL of the FastAPI backend
BACKEND_URL=http://127.0.0.1:8000

# API key to authenticate from the frontend to the backend
# For local dev, match a key present in API_KEYS_JSON for the backend
# e.g., export API_KEYS_JSON='{"test-key":["chat:read","chat:write"]}'
BACKEND_API_KEY=test-key

