# Backend service (FastAPI) — Coolify env placeholders

# Map of API key -> scopes the key has. Must contain a key
# the frontend will use with at least chat:write.
# Example: {"prod-key":["chat:read","chat:write"]}
API_KEYS_JSON=

# Comma-separated list of allowed origins for CORS.
# Example: https://deakyne.me,http://localhost:3000
CORS_ORIGINS=

# Optional analytics (PostHog)
POSTHOG_KEY=
POSTHOG_HOST=

# Optional Oso authorization policy
USE_OSO=
OSO_POLICY_PATH=

